{
  "compilerOptions": {
    "target": "ES2020",           // Современный стандарт JS
    "module": "commonjs",         // Стандарт модулей для Node.js
    "lib": ["ES2020"],
    "outDir": "./dist",           // Куда складывать скомпилированный код
    "rootDir": "./src",           // Где лежит исходный код
    "strict": true,               // Включаем строгий режим (максимальная защита)
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}